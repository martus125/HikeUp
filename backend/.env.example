# Local development. Set your own test/local database URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hikeup
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SESSION_HOURS=24
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
# Production: HTTPS, SESSION_COOKIE_SECURE=true.
# Cross-site frontend/backend: SESSION_COOKIE_SAMESITE=None.
# FRONTEND_ORIGINS must list exact frontend origins, without a trailing slash.
# Render production environment:
# FRONTEND_ORIGINS=https://hike-up-two.vercel.app
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=None
